# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# PostgreSQL connection string used by Prisma. Matches docker-compose.yml's
# local dev Postgres (port 5433, db "smart_academy", trust auth — dev only).
DATABASE_URL="postgresql://postgres@localhost:5433/smart_academy"

# HTTP port the NestJS server listens on.
PORT=8080

# JWT signing secrets. Generate real random values for any non-local
# environment, e.g.: openssl rand -hex 32
ACCESS_TOKEN_SECRET="dev-only-change-me-access"
REFRESH_TOKEN_SECRET="dev-only-change-me-refresh"

# Token lifetimes. Accepts jsonwebtoken-style strings (e.g. 15m, 1h, 21d).
ACCESS_TOKEN_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="21d"

# Comma-separated list of allowed frontend origins for CORS. The frontend's
# GraphQL client sends credentials, so this must be an explicit origin (never
# "*") with credentials enabled. Defaults to the frontend's dev server if unset.
CORS_ORIGIN="http://localhost:3000"
