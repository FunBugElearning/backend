generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  // MongoDB has no native foreign-key enforcement, so referential actions
  // below (onDelete: Cascade/SetNull/Restrict) are emulated by Prisma
  // Client itself rather than the database.
  relationMode = "prisma"
}

// Backs application-assigned integer ids (Mongo's _id has no native
// autoincrement). One document per model, incremented atomically via
// IdSequenceService. Keeping ids as plain integers - rather than switching
// to ObjectId - preserves the existing GraphQL contract (Int ids) and
// requires zero frontend changes.
model Counter {
  id  String @id @map("_id")
  seq Int    @default(0)
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum AssignmentStatus {
  draft
  published
  closed
}

enum NotificationType {
  enrollment
  assignment_published
  submission_received
  submission_graded
  attendance_updated
}

model User {
  id                        Int                 @id @map("_id")
  name                      String
  // Lowercased shadow copies of name/email, kept in sync on every write.
  // Prisma's MongoDB connector has no `mode: 'insensitive'` filter, so
  // case-insensitive search (ClassesService.searchStudents) matches against
  // these instead of doing a raw regex query with hand-hydrated results.
  nameLower                 String
  email                     String              @unique
  emailLower                String
  password                  String
  dateOfBirth               DateTime?
  address                   String?
  phoneNumber               String?
  role_id                   Int
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  authSessions              AuthSession[]
  authAuditLogs             AuthAuditLog[]
  classesAsTeacherIds       Int[]
  classesAsTeacher          Class[]             @relation("ClassTeachers", fields: [classesAsTeacherIds], references: [id])
  classesAsStudentIds       Int[]
  classesAsStudent          Class[]             @relation("ClassStudents", fields: [classesAsStudentIds], references: [id])
  classesCreated            Class[]             @relation("ClassCreator")
  attendanceSessionsCreated AttendanceSession[] @relation("AttendanceSessionCreator")
  attendanceRecords         AttendanceRecord[]  @relation("StudentAttendanceRecords")
  assignmentsCreated        Assignment[]        @relation("AssignmentCreator")
  submissions               Submission[]        @relation("StudentSubmissions")
  gradesGiven               Grade[]             @relation("GradesGiven")
  notifications             Notification[]      @relation("UserNotifications")

  role Role @relation(fields: [role_id], references: [id])

  @@index([role_id])
  @@index([classesAsTeacherIds])
  @@index([classesAsStudentIds])
  @@index([nameLower])
  @@index([emailLower])
}

model Role {
  id          Int      @id @map("_id")
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model AuthSession {
  id                Int       @id @map("_id")
  user_id           Int
  refresh_toke_hash String
  browser_agent     String
  ip_address        String
  expired_at        DateTime
  rotated_at        DateTime
  revoked_at        DateTime?
  created_at        DateTime  @default(now())
  family_id         String
  jti               String    @unique

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model AuthAuditLog {
  id            Int      @id @map("_id")
  user_id       Int
  event_type    String
  ip_address    String
  browser_agent String
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Class {
  id          Int      @id @map("_id")
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int?

  teacherIds         Int[]
  studentIds         Int[]
  teachers           User[]               @relation("ClassTeachers", fields: [teacherIds], references: [id])
  students           User[]               @relation("ClassStudents", fields: [studentIds], references: [id])
  assignments        Assignment[]
  attendanceSessions AttendanceSession[]
  gradeCategories    ClassGradeCategory[]
  createdBy          User?                @relation("ClassCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([teacherIds])
  @@index([studentIds])
}

model Assignment {
  id            Int              @id @map("_id")
  title         String
  description   String?
  deadline      DateTime
  topic         String?
  attachFiles   String[]         @default([])
  classId       Int
  categoryId    Int?
  maxScore      Float            @default(100)
  createdById   Int?
  // Existing rows (and anything created without an explicit status) default
  // to published so nothing already-visible silently disappears; the
  // service layer defaults *newly created* assignments to draft unless the
  // caller explicitly asks to publish. See .claude/DECISIONS.md.
  status        AssignmentStatus @default(published)
  allowResubmit Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  class       Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  category    ClassGradeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@index([classId])
  @@index([categoryId])
  @@index([createdById])
}

model AttendanceSession {
  id             Int      @id @map("_id")
  classId        Int
  createdById    Int
  attendanceDate DateTime
  title          String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class     Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy User               @relation("AttendanceSessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  records   AttendanceRecord[]

  @@index([classId])
  @@index([createdById])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  Int              @id @map("_id")
  attendanceSessionId Int
  studentId           Int
  status              AttendanceStatus
  note                String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student           User              @relation("StudentAttendanceRecords", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, studentId])
  @@index([attendanceSessionId])
  @@index([studentId])
  @@map("attendance_records")
}

model ClassGradeCategory {
  id        Int      @id @map("_id")
  classId   Int
  name      String
  weight    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@unique([classId, name])
  @@index([classId])
  @@map("class_grade_categories")
}

model Submission {
  id           Int      @id @map("_id")
  assignmentId Int
  studentId    Int
  content      String?
  attachFiles  String[] @default([])
  submittedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  grade      Grade?

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("submissions")
}

model Grade {
  id           Int      @id @map("_id")
  submissionId Int      @unique
  score        Float
  feedback     String?
  gradedById   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy   User       @relation("GradesGiven", fields: [gradedById], references: [id], onDelete: Restrict)

  @@index([gradedById])
  @@map("grades")
}

model Notification {
  id        Int              @id @map("_id")
  userId    Int
  type      NotificationType
  title     String
  body      String?
  // Ready-to-use frontend path (e.g. "/classes/5/assignments"), not a
  // generic resourceType/resourceId pair — simpler for the frontend to
  // consume directly, and this app has few enough notification shapes that
  // the extra indirection isn't worth it.
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}
