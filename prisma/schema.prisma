generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

model User {
  id                        Int                 @id @default(autoincrement())
  name                      String
  email                     String              @unique
  password                  String
  dateOfBirth               DateTime?
  address                   String?
  phoneNumber               String?
  role_id                   Int
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  authSessions              AuthSession[]
  authAuditLogs             AuthAuditLog[]
  classesAsTeacher          Class[]             @relation("ClassTeachers")
  classesAsStudent          Class[]             @relation("ClassStudents")
  classesCreated            Class[]             @relation("ClassCreator")
  attendanceSessionsCreated AttendanceSession[] @relation("AttendanceSessionCreator")
  attendanceRecords         AttendanceRecord[]  @relation("StudentAttendanceRecords")
  assignmentsCreated        Assignment[]        @relation("AssignmentCreator")
  submissions               Submission[]        @relation("StudentSubmissions")
  gradesGiven               Grade[]             @relation("GradesGiven")

  role Role @relation(fields: [role_id], references: [id])

  @@index([role_id])
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model AuthSession {
  id                Int       @id @default(autoincrement())
  user_id           Int
  refresh_toke_hash String
  browser_agent     String
  ip_address        String
  expired_at        DateTime
  rotated_at        DateTime
  revoked_at        DateTime?
  created_at        DateTime  @default(now())
  family_id         String
  jti               String    @unique

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model AuthAuditLog {
  id            Int      @id @default(autoincrement())
  user_id       Int
  event_type    String
  ip_address    String
  browser_agent String
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Class {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int?

  teachers           User[]               @relation("ClassTeachers")
  students           User[]               @relation("ClassStudents")
  assignments        Assignment[]
  attendanceSessions AttendanceSession[]
  gradeCategories    ClassGradeCategory[]
  createdBy          User?                @relation("ClassCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Assignment {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  deadline    DateTime
  topic       String?
  attachFiles String[] @default([])
  classId     Int
  categoryId  Int?
  maxScore    Float    @default(100)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class       Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  category    ClassGradeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@index([classId])
  @@index([categoryId])
  @@index([createdById])
}

model AttendanceSession {
  id             Int      @id @default(autoincrement())
  classId        Int
  createdById    Int
  attendanceDate DateTime
  title          String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class     Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy User               @relation("AttendanceSessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  records   AttendanceRecord[]

  @@index([classId])
  @@index([createdById])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  Int              @id @default(autoincrement())
  attendanceSessionId Int
  studentId           Int
  status              AttendanceStatus
  note                String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student           User              @relation("StudentAttendanceRecords", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, studentId])
  @@index([attendanceSessionId])
  @@index([studentId])
  @@map("attendance_records")
}

model ClassGradeCategory {
  id        Int      @id @default(autoincrement())
  classId   Int
  name      String
  weight    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@unique([classId, name])
  @@index([classId])
  @@map("class_grade_categories")
}

model Submission {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  content      String?
  attachFiles  String[] @default([])
  submittedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  grade      Grade?

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("submissions")
}

model Grade {
  id           Int      @id @default(autoincrement())
  submissionId Int      @unique
  score        Float
  feedback     String?
  gradedById   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy   User       @relation("GradesGiven", fields: [gradedById], references: [id], onDelete: Restrict)

  @@index([gradedById])
  @@map("grades")
}
